# LAN demo: bind all services on every interface (frontend still uses npm run dev -- --host).
# CODEX_BACKEND_HOST=0.0.0.0
# SKILL_SERVICE_HOST=0.0.0.0
# ORCHESTRATOR_HOST=0.0.0.0

# Required only for LLM-assisted task authoring
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_MODEL=gpt-5.6-luna

# Compile logs: detail (default), total, or off.
MJSKILL_COMPILE_PROFILE=total
MUJOCO_RESOLVER_DEBUG=0
COMPOUND_TURN=1

COMPILER_VERSION=v2
