# UI palette: light | dark
VITE_UI_THEME=light
VITE_ENABLE_CHECKPOINT_SAVE=false
VITE_ENABLE_CHECKPOINT_LOAD=false
# Replace successful compound-turn chat text with the study-safe "Plan updated." message.
VITE_STUDY_SIMPLE_COMPOUND_OUTPUT=true
# Show a second checkpoint selector that loads a hidden target for automatic matching.
VITE_ENABLE_STUDY_TARGET_LOAD=false
# Scene object labels shown with the CC control. Facilities are configured per manifest.
VITE_SHOW_SCENE_OBJECT_LABELS=true
