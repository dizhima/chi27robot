# Optional: override service URLs (defaults follow the page hostname, e.g. LAN IP).
# VITE_CODEX_BACKEND_URL=http://127.0.0.1:8787
# VITE_SKILL_SERVICE_URL=http://127.0.0.1:8899
# VITE_ORCHESTRATOR_URL=http://127.0.0.1:8900

# UI palette: light | dark
VITE_UI_THEME=light
VITE_ENABLE_CHECKPOINT_SAVE=false
VITE_ENABLE_CHECKPOINT_LOAD=false
# Compound output: false=normal, v1/true="Plan updated.", v2=deterministic full baseline plan.
VITE_STUDY_SIMPLE_COMPOUND_OUTPUT=false
# Show a second checkpoint selector that loads a hidden target for automatic matching.
VITE_ENABLE_STUDY_TARGET_LOAD=false
# Scene object labels shown with the CC control. Facilities are configured per manifest.
VITE_SHOW_SCENE_OBJECT_LABELS=true
# Explore button (live physics / dragging while a plan is loaded). Set false for user study.
VITE_ENABLE_EXPLORE=true
